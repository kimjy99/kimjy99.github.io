<nav class="nav__list">
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items" id="category_tag_menu">
      <li>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="/posts">📂 전체 게시글 ({{ site.posts.size }})</a></span>
      </li>
      <li>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="/categories/논문리뷰">📝 논문리뷰 ({{ site.categories['논문리뷰'].size }})</a></span>
        {% assign fav_tags = "Computer Vision/CV/Computer Vision, 3D Vision/3DV/3D Vision, NLP/NLP/NLP, Audio and Speech Processing/ASP/Audio & Speech, Reinforcement Learning/RL/RL" | split: ", " %}
        {% for fav_tag in fav_tags %}
          {% assign sep = fav_tag | split: "/" %}
          <ul v-show="flag_c">
            {% for tag in site.tags %}
              {% if tag[0] == sep[0] %}
                {% assign cnt = 0 %}
                {% for page in tag[1] %}
                  {% if page.url contains "%EB%85%BC%EB%AC%B8%EB%A6%AC%EB%B7%B0" %}
                    {% assign cnt = cnt | plus: 1 %}
                  {% endif %}
                {% endfor %}
                <li><a href="/categories/논문리뷰/?tags={{ sep[0] | slugify }}" class="">{{sep[2]}} ({{cnt}})</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endfor %}

        <span class="nav__sub-title" v-on:click='togglec()'><a href="/categories/프로그래밍">💻 구현 / 프로그래밍 ({{ site.categories['프로그래밍'].size }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="/categories/공부">📒 공부 ({{ site.categories['공부'].size }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="/categories/GAME">🎮 GAME ({{ site.categories['GAME'].size }})</a></span>
      </li>
  </ul>
</nav>